{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 Typo VS Code 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.cjs"],
      "preLaunchTask": "build-extension"
    }
  ]
}
