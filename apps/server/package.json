{
  "name": "@typo/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@hono/node-server --external:hono --external:ws --external:yjs --external:base64-js --external:drizzle-orm --external:pg --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@typo/core": "workspace:*",
    "base64-js": "^1.5.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "ws": "^8.18.3",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@typo/client": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0"
  }
}
