{
  "name": "typo-vscode",
  "displayName": "Formd — Collaborative Markdown",
  "description": "在 VS Code 中编辑和协作 Formd Markdown 文档",
  "version": "0.3.0",
  "publisher": "typo-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onFileSystem:typo",
    "onView:typo.notes",
    "onView:typo.recent"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "package": "pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "build:test": "esbuild test/suite.ts --bundle --platform=node --format=cjs --external:vscode --external:@playwright/test --outfile=dist/test.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "typo.openNote",
        "title": "Formd: 打开协作文档"
      },
      {
        "command": "typo.createNote",
        "title": "Formd: 新建协作文档",
        "icon": "$(add)"
      },
      {
        "command": "typo.deleteNote",
        "title": "Formd: 删除协作文档",
        "icon": "$(trash)"
      },
      {
        "command": "typo.refreshNotes",
        "title": "Formd: 刷新文档",
        "icon": "$(refresh)"
      },
      {
        "command": "typo.renameNote",
        "title": "Formd: 重命名文档",
        "icon": "$(edit)"
      },
      {
        "command": "typo.openInBrowser",
        "title": "Formd: 在 Web 中打开",
        "icon": "$(globe)"
      },
      {
        "command": "typo.configureServer",
        "title": "Formd: 配置服务器",
        "icon": "$(gear)"
      },
      {
        "command": "typo.undo",
        "title": "Formd: 撤销自己的修改",
        "icon": "$(discard)"
      },
      {
        "command": "typo.redo",
        "title": "Formd: 重做自己的修改",
        "icon": "$(redo)"
      },
      {
        "command": "typo.jumpToMember",
        "title": "Formd: 定位成员光标",
        "icon": "$(go-to-file)"
      },
      {
        "command": "typo.followMember",
        "title": "Formd: 跟随成员",
        "icon": "$(pin)"
      },
      {
        "command": "typo.stopFollowing",
        "title": "Formd: 停止跟随",
        "icon": "$(debug-stop)"
      },
      {
        "command": "typo.showMembers",
        "title": "Formd: 查看在线成员"
      },
      {
        "command": "typo.clearRecent",
        "title": "Formd: 清空最近访问",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "Formd",
      "properties": {
        "typo.serverUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "Formd API 服务地址"
        },
        "typo.webUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "Formd Web 客户端地址，用于在浏览器中打开文档"
        },
        "typo.displayName": {
          "type": "string",
          "default": "",
          "maxLength": 48,
          "description": "协作中显示的名称，留空使用访客名称"
        },
        "typo.cursorColor": {
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{6}$",
          "description": "协作光标颜色（十六进制），留空自动分配"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "typo",
          "title": "Formd",
          "icon": "media/typo.svg"
        }
      ]
    },
    "views": {
      "typo": [
        {
          "id": "typo.notes",
          "name": "协作文档",
          "icon": "media/typo.svg",
          "contextualTitle": "Formd"
        },
        {
          "id": "typo.recent",
          "name": "最近访问",
          "contextualTitle": "Formd 最近访问"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "typo.createNote",
          "when": "view == typo.notes",
          "group": "navigation@1"
        },
        {
          "command": "typo.refreshNotes",
          "when": "view == typo.notes",
          "group": "navigation@2"
        },
        {
          "command": "typo.configureServer",
          "when": "view == typo.notes",
          "group": "navigation@3"
        },
        {
          "command": "typo.clearRecent",
          "when": "view == typo.recent",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "typo.openInBrowser",
          "when": "(view == typo.notes || view == typo.recent) && viewItem == typoNote",
          "group": "inline@1"
        },
        {
          "command": "typo.renameNote",
          "when": "(view == typo.notes || view == typo.recent) && viewItem == typoNote",
          "group": "1_modify@1"
        },
        {
          "command": "typo.deleteNote",
          "when": "(view == typo.notes || view == typo.recent) && viewItem == typoNote",
          "group": "1_modify@2"
        }
      ],
      "commandPalette": [
        {
          "command": "typo.undo",
          "when": "resourceScheme == typo"
        },
        {
          "command": "typo.redo",
          "when": "resourceScheme == typo"
        }
      ]
    },
    "keybindings": [
      {
        "command": "typo.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && resourceScheme == typo"
      },
      {
        "command": "typo.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "editorTextFocus && resourceScheme == typo"
      },
      {
        "command": "typo.redo",
        "key": "ctrl+shift+z",
        "when": "editorTextFocus && resourceScheme == typo"
      }
    ]
  },
  "dependencies": {
    "@typo/client": "workspace:*",
    "ws": "^8.18.3",
    "@typo/y-vscode": "workspace:*",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  }
}
