{
  "name": "typo-vscode",
  "displayName": "Formd — Collaborative Markdown",
  "description": "%extension.description%",
  "version": "0.3.3",
  "publisher": "typo-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onFileSystem:typo",
    "onView:typo.notes",
    "onView:typo.recent"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "package": "pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "build:test": "esbuild test/suite.ts --bundle --platform=node --format=cjs --external:vscode --external:@playwright/test --outfile=dist/test.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "typo.openNote",
        "title": "%typo.openNote%"
      },
      {
        "command": "typo.createNote",
        "title": "%typo.createNote%",
        "icon": "$(add)"
      },
      {
        "command": "typo.createFolder",
        "title": "%typo.createFolder%",
        "icon": "$(new-folder)"
      },
      {
        "command": "typo.deleteNote",
        "title": "%typo.deleteNote%",
        "icon": "$(trash)"
      },
      {
        "command": "typo.refreshNotes",
        "title": "%typo.refreshNotes%",
        "icon": "$(refresh)"
      },
      {
        "command": "typo.renameNote",
        "title": "%typo.renameNote%",
        "icon": "$(edit)"
      },
      {
        "command": "typo.openInBrowser",
        "title": "%typo.openInBrowser%",
        "icon": "$(globe)"
      },
      {
        "command": "typo.configureServer",
        "title": "%typo.configureServer%",
        "icon": "$(gear)"
      },
      {
        "command": "typo.undo",
        "title": "%typo.undo%",
        "icon": "$(discard)"
      },
      {
        "command": "typo.redo",
        "title": "%typo.redo%",
        "icon": "$(redo)"
      },
      {
        "command": "typo.jumpToMember",
        "title": "%typo.jumpToMember%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "typo.followMember",
        "title": "%typo.followMember%",
        "icon": "$(pin)"
      },
      {
        "command": "typo.stopFollowing",
        "title": "%typo.stopFollowing%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "typo.showMembers",
        "title": "%typo.showMembers%"
      },
      {
        "command": "typo.clearRecent",
        "title": "%typo.clearRecent%",
        "icon": "$(clear-all)"
      },
      {
        "command": "typo.moveNote",
        "title": "%typo.moveNote%"
      },
      {
        "command": "typo.renameFolder",
        "title": "%typo.renameFolder%"
      },
      {
        "command": "typo.moveFolder",
        "title": "%typo.moveFolder%"
      },
      {
        "command": "typo.deleteFolder",
        "title": "%typo.deleteFolder%"
      }
    ],
    "configuration": {
      "title": "Formd",
      "properties": {
        "typo.serverUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "%typo.serverUrl.description%"
        },
        "typo.webUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "%typo.webUrl.description%"
        },
        "typo.displayName": {
          "type": "string",
          "default": "",
          "maxLength": 48,
          "description": "%typo.displayName.description%"
        },
        "typo.cursorColor": {
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{6}$",
          "description": "%typo.cursorColor.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "typo",
          "title": "Formd",
          "icon": "media/typo.svg"
        }
      ]
    },
    "views": {
      "typo": [
        {
          "id": "typo.notes",
          "name": "%view.notes%",
          "icon": "media/typo.svg",
          "contextualTitle": "Formd"
        },
        {
          "id": "typo.recent",
          "name": "%view.recent%",
          "contextualTitle": "%view.recent.context%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "typo.createNote",
          "when": "view == typo.notes",
          "group": "navigation@1"
        },
        {
          "command": "typo.createFolder",
          "when": "view == typo.notes",
          "group": "navigation@2"
        },
        {
          "command": "typo.refreshNotes",
          "when": "view == typo.notes",
          "group": "navigation@3"
        },
        {
          "command": "typo.configureServer",
          "when": "view == typo.notes",
          "group": "navigation@4"
        },
        {
          "command": "typo.clearRecent",
          "when": "view == typo.recent",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "typo.createNote",
          "when": "view == typo.notes && viewItem == typoFolder",
          "group": "1_create@1"
        },
        {
          "command": "typo.createFolder",
          "when": "view == typo.notes && viewItem == typoFolder",
          "group": "1_create@2"
        },
        {
          "command": "typo.openInBrowser",
          "when": "(view == typo.notes || view == typo.recent) && viewItem == typoNote",
          "group": "inline@1"
        },
        {
          "command": "typo.renameNote",
          "when": "(view == typo.notes || view == typo.recent) && viewItem == typoNote",
          "group": "1_modify@1"
        },
        {
          "command": "typo.deleteNote",
          "when": "(view == typo.notes || view == typo.recent) && viewItem == typoNote",
          "group": "1_modify@2"
        },
        {
          "command": "typo.moveNote",
          "when": "(view == typo.notes || view == typo.recent) && viewItem == typoNote",
          "group": "1_modify@3"
        },
        {
          "command": "typo.renameFolder",
          "when": "view == typo.notes && viewItem == typoFolder",
          "group": "1_modify@4"
        },
        {
          "command": "typo.moveFolder",
          "when": "view == typo.notes && viewItem == typoFolder",
          "group": "1_modify@5"
        },
        {
          "command": "typo.deleteFolder",
          "when": "view == typo.notes && viewItem == typoFolder",
          "group": "1_modify@6"
        }
      ],
      "commandPalette": [
        {
          "command": "typo.undo",
          "when": "resourceScheme == typo"
        },
        {
          "command": "typo.redo",
          "when": "resourceScheme == typo"
        },
        {
          "command": "typo.renameFolder",
          "when": "false"
        },
        {
          "command": "typo.moveFolder",
          "when": "false"
        },
        {
          "command": "typo.deleteFolder",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "typo.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && resourceScheme == typo"
      },
      {
        "command": "typo.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "editorTextFocus && resourceScheme == typo"
      },
      {
        "command": "typo.redo",
        "key": "ctrl+shift+z",
        "when": "editorTextFocus && resourceScheme == typo"
      }
    ]
  },
  "dependencies": {
    "@typo/client": "workspace:*",
    "@typo/y-vscode": "workspace:*",
    "ws": "^8.18.3",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@typo/core": "workspace:*",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  },
  "l10n": "./l10n"
}
