{
  "name": "formd-vscode",
  "displayName": "Formd — Collaborative Markdown",
  "icon": "media/formd-marketplace.png",
  "description": "%extension.description%",
  "version": "0.6.0",
  "publisher": "formd-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onFileSystem:formd"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "package": "pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "build:test": "esbuild test/suite.ts --bundle --platform=node --format=cjs --external:vscode --external:@playwright/test --outfile=dist/test.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "formd.editComment",
        "title": "%formd.editComment%",
        "icon": "$(edit)"
      },
      {
        "command": "formd.saveComment",
        "title": "%formd.saveComment%"
      },
      {
        "command": "formd.cancelCommentEdit",
        "title": "%formd.cancelCommentEdit%"
      },
      {
        "command": "formd.commentInbox",
        "title": "%formd.commentInbox%"
      },
      {
        "command": "formd.deleteComment",
        "title": "%formd.deleteComment%",
        "icon": "$(trash)"
      },
      {
        "command": "formd.submitComment",
        "title": "%formd.submitComment%"
      },
      {
        "command": "formd.resolveComment",
        "title": "%formd.resolveComment%"
      },
      {
        "command": "formd.reopenComment",
        "title": "%formd.reopenComment%"
      },
      {
        "command": "formd.recoverDraft",
        "title": "%formd.recoverDraft%"
      },
      {
        "command": "formd.exportMarkdown",
        "title": "%formd.exportMarkdown%"
      },
      {
        "command": "formd.retrySync",
        "title": "%formd.retrySync%"
      },
      {
        "command": "formd.openNote",
        "title": "%formd.openNote%"
      },
      {
        "command": "formd.createNote",
        "title": "%formd.createNote%",
        "category": "Formd",
        "icon": "$(add)"
      },
      {
        "command": "formd.createFolder",
        "title": "%formd.createFolder%",
        "category": "Formd",
        "icon": "$(new-folder)"
      },
      {
        "command": "formd.deleteNote",
        "title": "%formd.deleteNote%",
        "category": "Formd",
        "icon": "$(trash)"
      },
      {
        "command": "formd.refreshNotes",
        "title": "%formd.refreshNotes%",
        "icon": "$(refresh)"
      },
      {
        "command": "formd.renameNote",
        "title": "%formd.renameNote%",
        "category": "Formd",
        "icon": "$(edit)"
      },
      {
        "command": "formd.openInBrowser",
        "title": "%formd.openInBrowser%",
        "category": "Formd",
        "icon": "$(globe)"
      },
      {
        "command": "formd.configureServer",
        "title": "%formd.configureServer%",
        "icon": "$(gear)"
      },
      {
        "command": "formd.undo",
        "title": "%formd.undo%",
        "icon": "$(discard)"
      },
      {
        "command": "formd.redo",
        "title": "%formd.redo%",
        "icon": "$(redo)"
      },
      {
        "command": "formd.jumpToMember",
        "title": "%formd.jumpToMember%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "formd.followMember",
        "title": "%formd.followMember%",
        "icon": "$(pin)"
      },
      {
        "command": "formd.stopFollowing",
        "title": "%formd.stopFollowing%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "formd.showMembers",
        "title": "%formd.showMembers%"
      },
      {
        "command": "formd.clearRecent",
        "title": "%formd.clearRecent%",
        "icon": "$(clear-all)"
      },
      {
        "command": "formd.moveNote",
        "title": "%formd.moveNote%",
        "category": "Formd"
      },
      {
        "command": "formd.renameFolder",
        "title": "%formd.renameFolder%",
        "category": "Formd"
      },
      {
        "command": "formd.moveFolder",
        "title": "%formd.moveFolder%",
        "category": "Formd"
      },
      {
        "command": "formd.deleteFolder",
        "title": "%formd.deleteFolder%",
        "category": "Formd"
      }
    ],
    "configuration": {
      "title": "Formd",
      "properties": {
        "formd.serverUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "%formd.serverUrl.description%"
        },
        "formd.webUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "%formd.webUrl.description%"
        },
        "formd.displayName": {
          "type": "string",
          "default": "",
          "maxLength": 48,
          "description": "%formd.displayName.description%"
        },
        "formd.cursorColor": {
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{6}$",
          "description": "%formd.cursorColor.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "formd",
          "title": "Formd",
          "icon": "media/formd.svg"
        }
      ]
    },
    "views": {
      "formd": [
        {
          "id": "formd.notes",
          "name": "%view.notes%",
          "icon": "media/formd.svg",
          "contextualTitle": "Formd"
        },
        {
          "id": "formd.recent",
          "name": "%view.recent%",
          "contextualTitle": "%view.recent.context%"
        }
      ]
    },
    "menus": {
      "comments/comment/title": [
        {
          "command": "formd.editComment",
          "when": "commentController == formd && comment == formd-comment",
          "group": "inline@1"
        },
        {
          "command": "formd.deleteComment",
          "when": "commentController == formd && comment == formd-comment",
          "group": "inline"
        }
      ],
      "comments/comment/context": [
        {
          "command": "formd.saveComment",
          "when": "commentController == formd && comment == formd-comment",
          "group": "navigation@1"
        },
        {
          "command": "formd.cancelCommentEdit",
          "when": "commentController == formd && comment == formd-comment",
          "group": "navigation@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "formd.submitComment",
          "when": "commentController == formd && commentThread != formd-resolved",
          "group": "navigation@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "formd.resolveComment",
          "when": "commentController == formd && commentThread == formd-open"
        },
        {
          "command": "formd.reopenComment",
          "when": "commentController == formd && commentThread == formd-resolved"
        }
      ],
      "view/title": [
        {
          "command": "formd.createNote",
          "when": "view == formd.notes",
          "group": "navigation@1"
        },
        {
          "command": "formd.createFolder",
          "when": "view == formd.notes",
          "group": "navigation@2"
        },
        {
          "command": "formd.refreshNotes",
          "when": "view == formd.notes",
          "group": "navigation@3"
        },
        {
          "command": "formd.configureServer",
          "when": "view == formd.notes",
          "group": "navigation@4"
        },
        {
          "command": "formd.clearRecent",
          "when": "view == formd.recent",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "formd.createNote",
          "when": "view == formd.notes && viewItem == formdFolder",
          "group": "1_create@1"
        },
        {
          "command": "formd.createFolder",
          "when": "view == formd.notes && viewItem == formdFolder",
          "group": "1_create@2"
        },
        {
          "command": "formd.openInBrowser",
          "when": "(view == formd.notes || view == formd.recent) && viewItem == formdNote",
          "group": "inline@1"
        },
        {
          "command": "formd.renameNote",
          "when": "(view == formd.notes || view == formd.recent) && viewItem == formdNote",
          "group": "1_modify@1"
        },
        {
          "command": "formd.deleteNote",
          "when": "(view == formd.notes || view == formd.recent) && viewItem == formdNote",
          "group": "1_modify@2"
        },
        {
          "command": "formd.moveNote",
          "when": "(view == formd.notes || view == formd.recent) && viewItem == formdNote",
          "group": "1_modify@3"
        },
        {
          "command": "formd.renameFolder",
          "when": "view == formd.notes && viewItem == formdFolder",
          "group": "1_modify@4"
        },
        {
          "command": "formd.moveFolder",
          "when": "view == formd.notes && viewItem == formdFolder",
          "group": "1_modify@5"
        },
        {
          "command": "formd.deleteFolder",
          "when": "view == formd.notes && viewItem == formdFolder",
          "group": "1_modify@6"
        }
      ],
      "commandPalette": [
        {
          "command": "formd.editComment",
          "when": "false"
        },
        {
          "command": "formd.saveComment",
          "when": "false"
        },
        {
          "command": "formd.cancelCommentEdit",
          "when": "false"
        },
        {
          "command": "formd.deleteComment",
          "when": "false"
        },
        {
          "command": "formd.submitComment",
          "when": "false"
        },
        {
          "command": "formd.resolveComment",
          "when": "false"
        },
        {
          "command": "formd.reopenComment",
          "when": "false"
        },
        {
          "command": "formd.undo",
          "when": "resourceScheme == formd"
        },
        {
          "command": "formd.redo",
          "when": "resourceScheme == formd"
        },
        {
          "command": "formd.renameFolder",
          "when": "false"
        },
        {
          "command": "formd.moveFolder",
          "when": "false"
        },
        {
          "command": "formd.deleteFolder",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "formd.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && resourceScheme == formd"
      },
      {
        "command": "formd.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "editorTextFocus && resourceScheme == formd"
      },
      {
        "command": "formd.redo",
        "key": "ctrl+shift+z",
        "when": "editorTextFocus && resourceScheme == formd"
      }
    ]
  },
  "dependencies": {
    "@formd/client": "workspace:*",
    "@formd/y-vscode": "workspace:*",
    "ws": "^8.18.3",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@formd/core": "workspace:*",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  },
  "l10n": "./l10n"
}
