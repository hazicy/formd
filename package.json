{
  "name": "typo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @typo/web",
    "dev:server": "npm run dev -w @typo/server",
    "dev:mobile": "npm run start -w @typo/mobile",
    "build": "npm run build -w @typo/web && npm run build -w @typo/server && npm run build -w typo-vscode",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test packages/core/src/*.test.ts packages/y-vscode/src/*.test.ts apps/server/src/*.test.ts",
    "package:vscode": "npm run package -w typo-vscode",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "test:vscode": "npm run build -w typo-vscode && npm run build:test -w typo-vscode && tsx apps/vscode/test/run.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.19.2",
    "concurrently": "^9.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "@vscode/test-electron": "^2.5.2"
  },
  "overrides": {
    "markdown-it": "^14.3.3"
  }
}
