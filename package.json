{
  "name": "formd",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:web": "pnpm --filter @formd/web run dev",
    "dev:server": "pnpm --filter @formd/server run dev",
    "dev:mobile": "pnpm --filter @formd/mobile run start",
    "build": "pnpm --filter @formd/web run build && pnpm --filter @formd/server run build && pnpm --filter formd-vscode run build",
    "typecheck": "pnpm -r --filter \"./apps/**\" --filter \"./packages/**\" --if-present run typecheck",
    "test": "tsx --test packages/core/src/*.test.ts packages/y-vscode/src/*.test.ts apps/server/src/*.test.ts",
    "package:vscode": "pnpm --filter formd-vscode run package",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --filter \"./apps/**\" --filter \"./packages/**\" --if-present run lint",
    "test:vscode": "pnpm --filter formd-vscode run build && pnpm --filter formd-vscode run build:test && tsx apps/vscode/test/run.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.19.2",
    "concurrently": "^9.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "@vscode/test-electron": "^2.5.2"
  }
}
